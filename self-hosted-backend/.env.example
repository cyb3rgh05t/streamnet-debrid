# Public HTTPS domain used by the API and QR-code TV pairing. No path or trailing slash.
PUBLIC_BASE_URL=https://api.example.com
# Hostname Traefik routes to this container. Usually the same host as PUBLIC_BASE_URL.
TRAEFIK_HOST=api.example.com
# Name of the Traefik ACME/Let's Encrypt certificate resolver.
TRAEFIK_CERTRESOLVER=dns-cloudflare
# Docker image pulled by compose. Use a pinned sha tag for rollback/testing if needed.
STREAMNET_BACKEND_IMAGE=ghcr.io/cyb3rgh05t/streamnet-self-hosted-backend:latest

# PostgreSQL database created for the backend. These values stay on the server.
POSTGRES_DB=streamnet
POSTGRES_USER=streamnet
# Generate a long random password and keep it only in the server .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Internal Docker connection string; the host is the compose service name "postgres".
DATABASE_URL=postgresql://streamnet:replace-with-a-long-random-password@postgres:5432/streamnet

# Signs backend access tokens. Generate with: openssl rand -base64 48
# Never put this value in the APK, Git, or a public secret file.
JWT_SECRET=replace-with-a-long-random-secret
# Lifetime of short-lived access tokens, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
# Lifetime of refresh sessions, in days.
REFRESH_TOKEN_TTL_DAYS=30
# Internal HTTP port exposed to Traefik, not directly to the internet.
PORT=3000