# Public domain used by Traefik. Do not include a path or trailing slash.
PUBLIC_BASE_URL=https://api.example.com
TRAEFIK_HOST=api.example.com
TRAEFIK_CERTRESOLVER=dns-cloudflare
STREAMNET_BACKEND_IMAGE=ghcr.io/cyb3rgh05t/streamnet-self-hosted-backend:latest

# PostgreSQL service settings.
POSTGRES_DB=streamnet
POSTGRES_USER=streamnet
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://streamnet:replace-with-a-long-random-password@postgres:5432/streamnet

# Generate this with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000