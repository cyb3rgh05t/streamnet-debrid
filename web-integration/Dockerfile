FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM deps AS builder
COPY . .
ARG NEXT_PUBLIC_SELF_HOSTED="true"
ARG NEXT_PUBLIC_PAYWALL_ENABLED="false"
ARG NEXT_TELEMETRY_DISABLED="1"
ARG STREAMNET_BACKEND_URL="https://auth.mystreamnet.club"
ARG STREAMNET_CLOUDSYNC_URL="https://auth.mystreamnet.club"
ARG TMDB_API_KEY=""
ARG TRAKT_CLIENT_ID=""
ARG TRAKT_CLIENT_SECRET=""
ARG SIMKL_CLIENT_ID=""
ARG SIMKL_CLIENT_SECRET=""
ARG NEXT_PUBLIC_TELEGRAM_API_ID=""
ARG NEXT_PUBLIC_TELEGRAM_API_HASH=""
ARG NEXT_PUBLIC_ARVIO_RESOLVER_URL=""
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}
ENV NEXT_PUBLIC_PAYWALL_ENABLED=${NEXT_PUBLIC_PAYWALL_ENABLED}
ENV NEXT_TELEMETRY_DISABLED=${NEXT_TELEMETRY_DISABLED}
ENV STREAMNET_BACKEND_URL=${STREAMNET_BACKEND_URL}
ENV STREAMNET_CLOUDSYNC_URL=${STREAMNET_CLOUDSYNC_URL}
ENV TMDB_API_KEY=${TMDB_API_KEY}
ENV TRAKT_CLIENT_ID=${TRAKT_CLIENT_ID}
ENV TRAKT_CLIENT_SECRET=${TRAKT_CLIENT_SECRET}
ENV SIMKL_CLIENT_ID=${SIMKL_CLIENT_ID}
ENV SIMKL_CLIENT_SECRET=${SIMKL_CLIENT_SECRET}
ENV NEXT_PUBLIC_TELEGRAM_API_ID=${NEXT_PUBLIC_TELEGRAM_API_ID}
ENV NEXT_PUBLIC_TELEGRAM_API_HASH=${NEXT_PUBLIC_TELEGRAM_API_HASH}
ENV NEXT_PUBLIC_ARVIO_RESOLVER_URL=${NEXT_PUBLIC_ARVIO_RESOLVER_URL}
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
