# StreamNet self-hosted webplayer config
# Copy this file to .env and adjust values for your deployment.

NEXT_PUBLIC_SELF_HOSTED=true
NEXT_PUBLIC_PAYWALL_ENABLED=false
NEXT_TELEMETRY_DISABLED=1

# Image and Traefik settings for the separate webplayer server
STREAMNET_WEB_IMAGE=ghcr.io/cyb3rgh05t/streamnet-webplayer:latest
STREAMNET_WEB_HOST=web.streamnet.live
TRAEFIK_CERTRESOLVER=dns-cloudflare

# StreamNet backend (the backend server remains separate)
STREAMNET_BACKEND_URL=https://auth.mystreamnet.club
STREAMNET_CLOUDSYNC_URL=https://auth.mystreamnet.club

# Upstream web app runtime settings
TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
NEXT_PUBLIC_TELEGRAM_API_ID=
NEXT_PUBLIC_TELEGRAM_API_HASH=
NEXT_PUBLIC_ARVIO_RESOLVER_URL=
NEXT_PUBLIC_ALLOW_NETLIFY_MEDIA_PROXY=false
ALLOW_PRIVATE_PROXY=false
# The container is routed by Traefik; no host port is published.

