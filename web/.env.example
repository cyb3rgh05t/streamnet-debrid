# StreamNet self-hosted webplayer config
# Copy this file to .env and adjust values for your deployment.
SELF_HOSTED=true
STREAMNET_MEDIA_RESOLVER_URL=https://resolver.mydomain.com
# Image and Traefik settings for the separate webplayer server
STREAMNET_WEB_IMAGE=ghcr.io/cyb3rgh05t/streamnet-web:latest
STREAMNET_WEB_HOST=web.mydomain.com
TRAEFIK_CERTRESOLVER=dns-cloudflare
# StreamNet backend (the backend server remains separate)
STREAMNET_BACKEND_URL=https://auth.mydomain.com
# Public Xtream host used to construct each user's playlist URLs.
STREAMNET_TV_XTREAM_URL=https://live.mydomain.com
# Comma-separated IPTV origins permitted to use the CPU-limited AAC fallback.
STREAMNET_AUDIO_TRANSCODE_HOSTS=
# Concurrent FFmpeg audio conversions per web container (1-16).
STREAMNET_MAX_AUDIO_TRANSCODES=4
# Runtime provider credentials (optional; keep only integrations you use)
TMDB_API_KEY=
VOD_REQUEST_BASE_URL=https://request.mydomain.com
VODWISHARR_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# Shared secret that signs URLs the relay writes into IPTV playlists, so segments on changing hosts/IPs can be relayed.
# Set the same value as the PROXY_SIGNING_KEY secret of the resolver worker. Empty = only the host list applies.
# Generate with: openssl rand -base64 48
PROXY_SIGNING_KEY=